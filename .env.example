# Database connection string
# Or use a PG connection string
#DATABASE_URI=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=mydb
POSTGRES_PORT=5432

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=pgadminpass
PGADMIN_PORT=8080

DATABASE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@0.0.0.0:${POSTGRES_PORT}/${POSTGRES_DB}

# for pgadmin HOST in server: host.docker.internal

# Mapbox public token (required for PropertyMap component).
# Get one at https://account.mapbox.com/access-tokens/. Free tier covers
# up to 50,000 monthly map loads.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: choose a Mapbox style other than the default 'streets-v12'.
# Example: 'light-v11', 'dark-v11', 'satellite-streets-v12', or a custom
# style URL from Mapbox Studio.
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12


# HuggingFace text-embeddings-inference (TEI) endpoint. В docker-compose
# поднимается отдельным сервисом `tei`. Если пусто — AI-поиск отключится,
# сайт упадёт на keyword-поиск (graceful fallback).
EMBEDDINGS_URL=http://tei:80
# Имя модели для записи в БД (произвольное, для отслеживания версий).
EMBEDDING_MODEL=multilingual-e5-small
# Размерность векторов. Должна совпадать с реальной модели — иначе
# upsert упадёт. BGE-M3 = 1024, multilingual-e5-large = 1024,
# paraphrase-multilingual-MiniLM-L12-v2 = 384.
EMBEDDING_DIM=384

# ─── Аналитика (опционально) ───
# Yandex Metrika — id счётчика, обычно 8-значное число.
# Завести: https://metrika.yandex.ru/list. Включить webvisor + clickmap.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
# Google Analytics 4 — Measurement ID вида G-XXXXXXXXXX.
# Завести: https://analytics.google.com → Admin → Data Streams.
NEXT_PUBLIC_GA4_ID=

# ─── Уведомления о заявках (опционально) ───
# POST на этот URL при каждой новой заявке (/api/leads) — например,
# эндпоинт отдельного Telegram-бота, который шлёт сообщение агентству.
# Пусто — уведомления просто не отправляются.
LEAD_WEBHOOK_URL=
# Отправляется как `Authorization: Bearer <секрет>` — чтобы бот мог
# отличить реальный запрос с сайта от подделки на его эндпоинт.
LEAD_WEBHOOK_SECRET=

# ─── Email (опционально, нужен для magic-link входа в кабинет) ───
# Resend HTTP API — без письма magic-link просто пишется в console.warn.
# Полная инструкция (домен на Beget): docs/RESEND-BEGET-SETUP.md
RESEND_API_KEY=
# Адрес отправителя — домен должен быть верифицирован в Resend.
EMAIL_FROM=MegaDomic <no-reply@megadomic.ru>

# ─── OAuth провайдеры (опционально) ───
# Полная инструкция: docs/AUTH-OAUTH-SETUP.md
# Redirect URI для всех: https://yourdomain.ru/api/auth/oauth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=

# ─── Recommendation Engine LLM (опционально, ~$1/мес при 5000 запр./день) ───
# Anthropic Claude Haiku — для извлечения фильтров из NL + объяснений
# «почему рекомендуем». Без ключа recommendation engine продолжает
# работать на чистых embeddings + heuristic (бесплатно, без объяснений).
# Получить ключ: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Модель — опционально, default 'claude-haiku-4-5'.
ANTHROPIC_MODEL=

# OpenAI gpt-4o-mini — bulk SEO-генерация landing-страниц.
# В 5× дешевле Anthropic Haiku при сравнимом качестве на русском.
# 100 landing'ов ≈ $0.05. См. docs/SEO-GENERATION.md
OPENAI_API_KEY=
# Модель — опционально, default 'gpt-4o-mini'.
OPENAI_MODEL=